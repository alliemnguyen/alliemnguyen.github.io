@article{Nguyen.etal2026a,
  title = {From rooftop pilots to campus-scale stormwater modelling: assessing green roof performance for urban flood mitigation in Hanoi},
  author = {*Nguyen, Minh-Anh* and Ung, Chi Thi Linh, Dao, Anh Dzung and Chinh, Loi Dinh, Nguyen, Viet-Anh},
  year = {2026},
  month = {Nov},
  journal = {Blue-Green Systems},
  publisher = {IWA Publishing},
  url = {https://iwaponline.com/bgs/article/8/2/501/113830/From-rooftop-pilots-to-campus-scale-stormwater},
  doi = {10.2166/bgs.2026.027},
  pdf = {Article_Nguyen_etal2026a.pdf},
  abstract = {Urban flooding is an increasing challenge in dense cities where impervious surfaces accelerate runoff and overload drainage systems. This study evaluates green roofs as a distributed source-control measure for stormwater management at Hanoi University of Civil Engineering (HUCE), Vietnam, using an integrated experimental–modelling framework that combines pilot-scale roof observations with SewerGEMS-based campus-scale drainage simulations. Green roof scenarios were assessed by varying antecedent moisture conditions, planting soil thickness, rainfall magnitude, and rooftop coverage. The results showed that antecedent soil moisture strongly controlled green roof performance. The non-irrigated green roof achieved the highest runoff reduction, peak attenuation, and peak delay, while irrigated systems performed less effectively due to reduced available storage. Increasing planting soil thickness from 80 to 250 mm improved runoff retention, with the 250-mm configuration providing the greatest hydrological benefit. At the campus scale, green roof implementation reduced runoff volume and peak discharge, with a maximum runoff reduction of 84.55% under full rooftop coverage. Water-level analysis at MH09, the most flood-prone drainage manhole in the campus stormwater network, showed that green roofs mitigated drainage stress under moderate rainfall but were insufficient as a standalone solution under extreme storms. The findings supported integrating green roofs into multi-layered urban stormwater strategies.},
  preview = {Nguyen-etal2026a-preview-HUCEgreenroofs.png},
  selected = {true}
}

@article{Nguyen.etal2026,
  title = {Wastewater Reuse in {{Vietnam}}: Potential, Challenges, and Strategic Solutions},
  author = {*Nguyen, Minh-Anh* and Ung, Chi Thi Linh and Dao, Anh Dzung and Chinh, Loi Dinh and Nguyen, Viet-Anh},
  year = {2026},
  month = {Jun},
  journal = {Water Reuse},
  publisher = {IWA Publishing},
  url = {https://iwaponline.com/jwrd/article/doi/10.2166/wrd.2026.152/112043/Wastewater-reuse-in-Vietnam-potential-challenges},
  doi = {10.2166/wrd.2026.152},
  pdf = {Article_Nguyen_etal2026.pdf},
  abstract = {Vietnam faces growing pressure on water resources due to rapid urbanization, industrial expansion, climate change, and declining water quality. Wastewater reuse offers a promising pathway to enhance water security, reduce pollution, and advance circular-economy objectives. This study assessed wastewater reuse potential in Vietnam through a mixed qualitative approach: a systematic review of international experience, targeted review of Vietnamese policies and sectoral evidence, screening of 2,511 wastewater-generating projects reported on the national environmental consultation portal, detailed analysis of 118 selected projects, and validation through stakeholder consultation and questionnaire survey. Results show that wastewater reuse in Vietnam is driven mainly by rising water demand, environmental pressure, and regulatory interest in resource circulation, and emerging market incentives linked to green production and supply chains. However, implementation remains limited and uneven across sectors. Manufacturing and tourism projects show the strongest uptake, while industrial park infrastructure, urban systems, and livestock applications face greater institutional, technical, and economic constraints. Main barriers are the absence of fit-for-purpose reclaimed-water standards, fragmented institutional responsibilities, high treatment and monitoring costs, limited financial incentives, and low implementation confidence. Scale-up will require clearer regulation, stronger inter-agency coordination, targeted incentives, improved technical capacity, and explicit integration into long-term water and urban development strategies.},
  preview = {Nguyen-etal2026-preview-WWreuseVN.png},
  selected = {true}
}

@article{Wang.etal2025,
  title = {Benchmarking {{Concentration}} and {{Extraction Methods}} for {{Wastewater-Based Surveillance}} of {{Eight Human Respiratory Viruses}}: {{Implications}} for {{Rapid Application}} to {{Novel Respiratory Threats}}},
  author = {Wang, Audrey Liwen and Jiang, Minxi and *Nguyen, Allie* and Kane, Staci R. and Borucki, Monica K. and Kantor, Rose S. and Nelson, Kara L.},
  year = {2025},
